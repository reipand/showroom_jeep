{
    "name": "showroom-web/jeep-showroom",
    "description": "Jeep Showroom Web Application",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "google/cloud-recaptcha-enterprise": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
